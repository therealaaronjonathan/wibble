# Copy to .env.local (gitignored) and fill in. Read by Vite at build time.

# Firebase Auth uid of the tracked person (the "patient"). Find it in the
# Firebase console under Authentication → Users after their first sign-in.
VITE_PATIENT_UID=

# First name shown in the daily message and the "Viewing <name>'s day" tag.
VITE_PATIENT_NAME=
